#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

export PYTHONPATH="$REPO_ROOT:${PYTHONPATH:-}"
export MULTIGRAVITY_CONFIG="${MULTIGRAVITY_CONFIG:-$REPO_ROOT/config.local.toml}"

# Check for help flags
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat << 'EOF'
mgy - Multigravity Launcher & Orchestrator

Usage:
  mgy                  Launch interactive agy with Multigravity fleet prompt
  mgy "user prompt"    Launch agy with initial prompt and fleet instructions
  mgy [agy options]    Pass options directly to agy (e.g. -c to continue, --mode plan)
  mgy status           Check current worker status board
  mgy doctor           Run system diagnostics and collision verification
  mgy login [worker]   Log in worker accounts interactively
  mgy stop             Stop background core daemon

Notes:
  - All tool calls, MCP actions, and shell commands are auto-approved without prompting.
  - To require manual confirmation, set MGY_NO_SKIP_PERMISSIONS=1 or pass --no-skip-permissions.
EOF

    exit 0
fi

# Subcommands routing
case "${1:-}" in
    status)
        exec python3 -m multigravity.cli status "${@:2}"
        ;;
    doctor)
        exec python3 -m multigravity.cli doctor "${@:2}"
        ;;
    login)
        exec python3 -m multigravity.cli login "${@:2}"
        ;;
    stop)
        exec python3 -m multigravity.cli stop "${@:2}"
        ;;
esac

# 1. Run launcher preflight, auto-healing, and prompt generation
PROMPT_OUTPUT=$(python3 -m multigravity.launcher)
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
    echo "[!] Multigravity preflight failed. Please resolve above errors." >&2
    exit $EXIT_CODE
fi

AGY_BIN="${AGY_BIN:-/usr/sbin/agy}"
if [ ! -x "$AGY_BIN" ]; then
    AGY_BIN="$(which agy 2>/dev/null || true)"
fi

if [ -z "$AGY_BIN" ] || [ ! -x "$AGY_BIN" ]; then
    echo "[!] agy binary not found. Please ensure Antigravity CLI is installed." >&2
    exit 1
fi

# 2. Setup cleanup trap: when main agy exits or is killed, cleanly terminate workers and daemon
cleanup_fleet() {
    local rc=$?
    trap - EXIT INT TERM HUP
    echo ""
    echo "=============================================================================="
    echo "Multigravity: Main agent session ended. Stopping fleet and cleaning up..."
    echo "=============================================================================="
    python3 -m multigravity.cleanup --timeout 4.0 || true
    exit "$rc"
}
trap cleanup_fleet EXIT INT TERM HUP

# 3. Launch interactive agy with prompt, remote control, and auto-approved permissions
REMOTE_CTRL_FLAG="--remote-control"
SKIP_PERMS_FLAG="--dangerously-skip-permissions"

if [[ "${MGY_NO_SKIP_PERMISSIONS:-0}" == "1" ]] || [[ " $* " =~ " --no-skip-permissions " ]]; then
    SKIP_PERMS_FLAG=""
fi

AUTO_FLAGS=()
[ -n "$REMOTE_CTRL_FLAG" ] && AUTO_FLAGS+=("$REMOTE_CTRL_FLAG")
[ -n "$SKIP_PERMS_FLAG" ] && AUTO_FLAGS+=("$SKIP_PERMS_FLAG")

if [ $# -eq 0 ]; then
    # No arguments: launch with fleet prompt, remote control, and auto-approved permissions
    "$AGY_BIN" "${AUTO_FLAGS[@]}" -i "$PROMPT_OUTPUT"
elif [[ "${1:-}" == -* ]]; then
    # User passed flags (e.g. -c, --mode plan): include auto flags if not present
    CMD_ARGS=()
    for flag in "${AUTO_FLAGS[@]}"; do
        if [[ ! " $* " =~ " $flag " ]]; then
            CMD_ARGS+=("$flag")
        fi
    done
    "$AGY_BIN" "${CMD_ARGS[@]}" "$@"
else
    # User passed a text prompt: combine fleet prompt with user prompt and auto flags
    USER_PROMPT="$1"
    shift
    "$AGY_BIN" "${AUTO_FLAGS[@]}" -i "$PROMPT_OUTPUT

---
User Request:
$USER_PROMPT

Direct Orchestration Mandate:
Decompose this request immediately into parallel background tasks and dispatch them to the Multigravity worker fleet via submit_task. Do NOT attempt deep file search or heavy reading locally." "$@"
fi


